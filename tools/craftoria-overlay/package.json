{
  "name": "craftoria-overlay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "export": "tsx src/cli.ts export",
    "export:client": "tsx src/cli.ts export-client",
    "sync": "tsx src/cli.ts sync",
    "diff": "tsx src/cli.ts diff",
    "capture-typings": "tsx src/cli.ts capture-typings",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && tsx --test src/**/*.test.ts",
    "install-dev-skills": "pnpm run cli install-dev-skills"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/yargs": "^17.0.35",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yargs": "^18.1.0"
  }
}
