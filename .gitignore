# This repository owns only the customizations around the Craftoria instance.
# Ignore every top-level entry by default so new PrismLauncher/Craftoria files
# do not become untracked when the instance is updated or launched.
/*

# Repository metadata.
!/.gitignore

# Customizations maintained in this repository.
!/.agents/
!/.agents/**
!/.claude/
!/.claude/**
!/tools/
!/tools/**

# Generated by tools/craftoria-overlay install-dev-skills.
# Keep the project-specific craftoria-kubejs skill, but ignore copied generic
# skills that can be installed again by the tool.
/.agents/skills/minecraft-modding/
/.agents/skills/minecraft-server-admin/
/.agents/skills/minecraft-testing/
/.agents/skills/minecraft-ci-release/
/.agents/skills/minecraft-datapack/
/.agents/skills/minecraft-resource-pack/
/.agents/skills/mc-develop-first/

/.claude/skills/minecraft-modding/
/.claude/skills/minecraft-server-admin/
/.claude/skills/minecraft-testing/
/.claude/skills/minecraft-ci-release/
/.claude/skills/minecraft-datapack/
/.claude/skills/minecraft-resource-pack/
/.claude/skills/mc-develop-first/
